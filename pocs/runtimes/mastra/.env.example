# Optional. Without this key, the Next dashboard uses deterministic mock mode by default.
MISTRAL_API_KEY=
ALBERT_API_KEY=

# Mastra/Next local URLs
MASTRA_BASE_URL=http://localhost:4111
NEXT_BASE_URL=http://localhost:3009

# Mastra storage and model
MASTRA_STORAGE_URL=file:./data/mastra.db
MASTRA_PROVIDER=mistral
MASTRA_MODEL=mistral-small-latest
MISTRAL_MODEL=mistral-small-latest
ALBERT_BASE_URL=https://albert.api.etalab.gouv.fr/v1
ALBERT_MODEL=albert-large
