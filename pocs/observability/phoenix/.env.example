# Phoenix local collector; HTTP/protobuf endpoint.
PHOENIX_OTEL_ENDPOINT=http://127.0.0.1:6006/v1/traces
PHOENIX_PROJECT_NAME=ansu-phoenix-langchain-demo

# Optional: duplicate traces to an OpenTelemetry Collector that exports to Grafana Tempo.
# In production, prefer collector fan-out rather than app -> N backends.
# GRAFANA_OTEL_ENDPOINT=http://127.0.0.1:4318/v1/traces

# Optional LLM providers. If none is set, the demo uses a deterministic fake LangChain chat model.
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-small-latest
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
